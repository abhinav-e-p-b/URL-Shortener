<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config
    - Forces HTTPS for all connections (no cleartext)
    - Pins our Render domain for extra security in release builds
    Replace the sha256 pin below with your actual certificate pin
    (run: openssl s_client -connect url-shortener-1-m70j.onrender.com:443 | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only for local dev (debug builds via localhost / 10.0.2.2) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
